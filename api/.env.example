# Copiar este archivo como .env y completar los valores.
# .env NUNCA se sube al repositorio.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"

# Puerto de la API
PORT=3000

# Origen del front permitido por CORS y usado en los enlaces de los emails
WEB_ORIGIN="http://localhost:4200"

# Clave para firmar las sesiones. Debe ser larga y aleatoria; generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Duración de la sesión en días
SESSION_DAYS=7
