// Modelo de datos del MVP — Marketplace de instrumentos usados
// Cada bloque del backlog usa una parte; se define completo para evitar migraciones grandes después.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVO
  SUSPENDIDO
  ELIMINADO
}

enum TokenType {
  VERIFICACION_EMAIL
  RECUPERO_PASSWORD
}

enum AccountType {
  PARTICULAR
  COMERCIO
}

enum SellerStatus {
  PENDIENTE // falta pago y/o verificación de DNI
  ACTIVO
  SUSPENDIDO
}

enum VerificationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
  REEMBOLSADO
}

enum Currency {
  ARS
  USD
}

enum ItemCondition {
  NUEVO
  COMO_NUEVO
  MUY_BUENO
  BUENO
  REGULAR
  PARA_REPUESTO
}

enum ListingStatus {
  BORRADOR
  ACTIVA
  PAUSADA
  RESERVADA
  VENDIDA
  ELIMINADA
}

enum ReportTarget {
  LISTING
  USER
}

enum ReportReason {
  FRAUDE
  ARTICULO_PROHIBIDO
  INFORMACION_FALSA
  SPAM
  CONTENIDO_OFENSIVO
  OTRO
}

enum ReportStatus {
  ABIERTA
  RESUELTA
  DESCARTADA
}

// ─────────────────────────────── Cuentas ───────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  displayName     String
  avatarUrl       String?
  province        String?
  city            String?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVO)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  tokens            AuthToken[]
  sellerProfile     SellerProfile?
  listings          Listing[]
  favorites         Favorite[]
  buyerChats        Conversation[]         @relation("BuyerConversations")
  sellerChats       Conversation[]         @relation("SellerConversations")
  messages          Message[]
  blocksMade        Block[]                @relation("Blocker")
  blocksReceived    Block[]                @relation("Blocked")
  reportsMade       Report[]               @relation("Reporter")
  reportsReceived   Report[]               @relation("ReportedUser")
  reportsResolved   Report[]               @relation("ReportResolver")
  verificationsDone IdentityVerification[] @relation("VerificationReviewer")
  auditLogs         AuditLog[]
  settingsUpdated   AppSetting[]

  @@map("users")
}

// Tokens de un solo uso: verificación de email y recupero de contraseña.
// Se guarda solo el hash del token, nunca el token en claro.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ─────────────────────────── Perfil de vendedor ───────────────────────────

model SellerProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @db.Uuid
  accountType  AccountType
  businessName String? // obligatorio si es COMERCIO
  cuit         String? // obligatorio si es COMERCIO
  status       SellerStatus @default(PENDIENTE)
  activatedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications IdentityVerification[]
  payments      Payment[]

  @@map("seller_profiles")
}

// Verificación de identidad con foto del DNI.
// La imagen vive en almacenamiento privado; imageKey se borra tras la revisión (RNF-5).
model IdentityVerification {
  id              String             @id @default(uuid()) @db.Uuid
  sellerProfileId String             @db.Uuid
  status          VerificationStatus @default(PENDIENTE)
  imageKey        String?
  imageDeletedAt  DateTime?
  rejectionReason String?
  reviewedById    String?            @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("identity_verifications")
}

// Arancel único de activación (2 USD cobrados en ARS al blue del momento).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  sellerProfileId   String        @db.Uuid
  amountUsd         Decimal       @db.Decimal(10, 2)
  exchangeRate      Decimal       @db.Decimal(12, 2)
  amountArs         Decimal       @db.Decimal(12, 2)
  exchangeRateId    String?       @db.Uuid
  provider          String        @default("MERCADO_PAGO")
  providerPrefId    String?
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDIENTE)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  rate          ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  @@index([status])
  @@map("payments")
}

// ─────────────────────────────── Cotización ───────────────────────────────

// Histórico de cotizaciones obtenidas (DolarAPI u otra fuente de respaldo).
model ExchangeRate {
  id              String   @id @default(uuid()) @db.Uuid
  source          String // "dolarapi", "respaldo", "manual"
  kind            String // "blue", "oficial", ...
  buy             Decimal  @db.Decimal(12, 2)
  sell            Decimal  @db.Decimal(12, 2)
  sourceUpdatedAt DateTime
  fetchedAt       DateTime @default(now())

  payments Payment[]

  @@index([kind, fetchedAt])
  @@map("exchange_rates")
}

// ─────────────────────────────── Catálogo ───────────────────────────────

// Árbol de categorías: permite subcategorías sin rediseñar.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  name     String
  slug     String  @unique
  order    Int     @default(0)
  active   Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  listings Listing[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  slug     String    @unique
  active   Boolean   @default(true)
  listings Listing[]

  @@map("brands")
}

// ─────────────────────────────── Publicaciones ───────────────────────────────

model Listing {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  sellerId           String        @db.Uuid
  categoryId         String        @db.Uuid
  brandId            String?       @db.Uuid
  brandOther         String? // marca escrita a mano si no está en la lista
  model              String?
  year               Int?
  title              String
  description        String?
  condition          ItemCondition
  defects            String?
  repairs            String?
  modifications      String?
  accessories        String?
  priceAmount        Decimal       @db.Decimal(14, 2)
  currency           Currency
  priceArsNormalized Decimal       @db.Decimal(14, 2) // solo para filtrar y ordenar
  province           String
  city               String
  deliveryPickup     Boolean       @default(false)
  deliveryShipping   Boolean       @default(false)
  deliveryToAgree    Boolean       @default(false)
  status             ListingStatus @default(BORRADOR)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller        User           @relation(fields: [sellerId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  brand         Brand?         @relation(fields: [brandId], references: [id])
  photos        ListingPhoto[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]

  @@index([status, publishedAt])
  @@index([status, categoryId])
  @@index([status, priceArsNormalized])
  @@index([status, province])
  @@index([sellerId, status])
  @@map("listings")
}

model ListingPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @db.Uuid
  storageKey String
  url        String
  position   Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_photos")
}

model Favorite {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("favorites")
}

// ─────────────────────────────── Mensajería ───────────────────────────────

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  listingId     String   @db.Uuid
  buyerId       String   @db.Uuid
  sellerId      String   @db.Uuid
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  listing  Listing   @relation(fields: [listingId], references: [id])
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  body           String
  hasContactData Boolean   @default(false) // teléfono, CBU, alias o enlaces (RF-6.5)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────────── Confianza y moderación ───────────────────────────

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  targetType     ReportTarget
  listingId      String?      @db.Uuid
  reportedUserId String?      @db.Uuid
  reason         ReportReason
  comment        String?
  status         ReportStatus @default(ABIERTA)
  resolution     String?
  resolvedById   String?      @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id])
  listing      Listing? @relation(fields: [listingId], references: [id])
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  resolvedBy   User?    @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@map("reports")
}

// ─────────────────────────── Administración ───────────────────────────

// Configuración editable desde el panel (arancel, cotización de referencia, límites de uso).
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

// Registro de auditoría: solo se inserta, nunca se edita ni borra (RNF-11).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
